module counter(input clk, reset_n, enable, output reg[WIDTH-1:0] result);
    parameter WIDTH=4;
    always@(posedge clk, negedge reset_n)
        if(!reset_n) begin
            result <= {WIDTH{1'b0}};
        end else if(enable) begin
            result <= result + 1'b1;
        end
endmodule

module mod1(HEX0);
    output [6:0] HEX0;
    assign HEX0[6:0]=7'b1111111; // HEX0 is OFF
endmodule

module mod2(input [3:0] SW, output [6:0] HEX0);
    reg [6:0] reg_LEDs;
    assign HEX0[0]= (~SW[3]&~SW[2]&~SW[1]&SW[0]) | (~SW[3]&SW[2]&~SW[1]&~SW[0]) | (SW[3]&~SW[2]&SW[1]&SW[0]) | (SW[3]&SW[2]&SW[1]&SW[0]);/* eSWpression for segment 0 ::::: ~A~B~CD + ~AB~C~D + A~BCD + ABCD */
    assign HEX0[1]= (~SW[3]&SW[2]&~SW[1]&SW[0]) | (SW[3]&~SW[2]&SW[1]&~SW[0]) | (SW[3]&SW[2]&~SW[1]&SW[0]) | (SW[3]&SW[2]&SW[1]&~SW[0]) | (SW[3]&SW[2]&SW[1]&SW[0])  | (~SW[3]&SW[2]&SW[1]&~SW[0])  ;/* eSWpression for segment 1 ::::: ~AB~CD + A~BC~D+AB~CD+ABC~D+ABCD*/
    assign HEX0[6:2]=reg_LEDs[6:2];
    always @(*)
    begin
        case (SW)
            4'b0000: reg_LEDs[6:2]=5'b10000; //7’b1000000 decimal 0
            4'b0001: reg_LEDs[6:2]=5'b11110; //7’b1111001 decimal 1
            4'b0010: reg_LEDs[6:2]=5'b01001; //7’b0100100 decimal 2
            4'b0011: reg_LEDs[6:2]=5'b01100; //7’b1000000 decimal 3
            4'b0100: reg_LEDs[6:2]=5'b00110; //7’b1111001 decimal 4
            4'b0101: reg_LEDs[6:2]=5'b00100; //7’b0100100 decimal 5
            4'b0110: reg_LEDs[6:2]=5'b00000; //7’b1000000 decimal 6
            4'b0111: reg_LEDs[6:2]=5'b11110; //7’b1111001 decimal 7
            4'b1000: reg_LEDs[6:2]=5'b00000; //7’b0100100 decimal 8
            4'b1001: reg_LEDs[6:2]=5'b00100; //7’b1000000 decimal 9
            4'b1010: reg_LEDs[6:2]=5'b00100; //7’b1111001 decimal S
            4'b1011: reg_LEDs[6:2]=5'b11110; //7’b0100100 decimal I
            4'b1100: reg_LEDs[6:2]=5'b00010; //7’b0100100 decimal R
            4'b1101: reg_LEDs[6:2]=5'b00001; //7’b1000000 decimal E
            4'b1110: reg_LEDs[6:2]=5'b00001; //7’b1111001 decimal E
            4'b1111: reg_LEDs[6:2]=5'b11111; //7’b0100100 decimal Off
            /* finish the case block */
        endcase
    end
endmodule

module mod3(KEY, result);
	input [3:0] KEY;
	output reg [3:0] result;
	always@(negedge KEY[3] or negedge KEY[0])
		begin				//buttons activate on negedge
		if(!KEY[0])
			begin
			result <= 4'b0;
			end
		else begin
			result <= result + 1'b1;
			end
	end
endmodule


module mod4(input clk, reset_n, output [6:0] HEX0);
    wire [29:0] cnt_res;       // unique counter result wire
    wire [6:0] mod2_out_unique; // unique wire for mod2 output

    // 30-bit counter
    counter #(.WIDTH(30)) counter_mod4 (
        .clk(clk),
        .reset_n(reset_n),
        .enable(1'b1),
        .result(cnt_res)
    );

    // top 4 bits go to mod2
    mod2 decoder_mod4 (
        .SW(cnt_res[29:26]),
        .HEX0(mod2_out_unique)
    );

    // assign mod2 output to HEX0
    assign HEX0 = mod2_out_unique;
endmodule



module lab1part3(SW, KEY, CLOCK_50,HEX0);
    input [9:0] SW;
    input [3:0] KEY;
	 input CLOCK_50;
    output reg [6:0] HEX0;
    wire [6:0] mod1_wire;
	 wire [6:0] mod2_wire;
	 wire [3:0] mod3_wire;
	 wire [6:0] mod4_wire;
	 wire [6:0] mod5_wire;
	 
    
    //instanciate the mod1
    mod1 m1(.HEX0(mod1_wire));
	 mod2 m2(SW[3:0],mod2_wire); //instanciate the mod2
	 mod3 m3(KEY[3:0],mod3_wire);
	 mod2 m4(mod3_wire[3:0], mod4_wire);
	 mod4 m5(CLOCK_50, KEY[0], mod5_wire);


    always @(*)
    begin
		  //count = 4'b1110;
        if (SW[8]==1 && SW[9]==1)
            begin
                HEX0[6:0] = mod1_wire;
            end
        else if (SW[8]==0 && SW[9]==0)
				begin
                HEX0[6:0] = mod2_wire; 
				end
			else if (SW[9]==0 && SW[8]==1)
				begin
					HEX0[6:0] = mod4_wire;
				end 
			else if (SW[9]==1 && SW[8]==0)
				begin
					HEX0[6:0] = mod5_wire;
				end 
			else begin
				HEX0[6:0] = 7'b0000000;
				end
    end
	 
endmodule

