module counter(input clk, reset_n, enable, output reg[WIDTH-1:0] result);
    parameter WIDTH=4;
    always@(posedge clk, negedge reset_n)
        if(!reset_n) begin
            result <= {WIDTH{1'b0}};
        end else if(enable) begin
            result <= result + 1'b1;
        end
endmodule

