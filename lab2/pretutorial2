// Clock Divider: slows the clock signal from 50MHz to 1KHz
module clock_divider (input wire factor, clk_in, reset_n, output reg clk_out);
    reg [(factor/2)-1:0] counter;
 
    always @(posedge clk_in or negedge reset_n) begin
        if (!reset_n) begin
            counter <= 0;
            clk_out <= 0;
        end else begin
            if (counter == ((factor/2)-1)) begin
                counter <= 0;
                clk_out <= ~clk_out;  // Toggle output clock
            end else begin
                counter <= counter + 1;
            end
        end
    end
endmodule

//Clock divder for simulation purposes
module Tut2(
    input Clk, 
    input Reset_n, 
    output reg clk_ms
);
    parameter factor = 4;
    reg [31:0] countQ;
    
    always @(posedge Clk or negedge Reset_n) begin
        if (!Reset_n) begin
            countQ <= 32'd0;
            clk_ms <= 1'b0;         // Fixed: 1-bit
        end
        else begin
            // Increment and wrap counter
            if (countQ == factor - 1) begin
                countQ <= 32'd0;
            end
            else begin
                countQ <= countQ + 1;
            end
            
            // Set output based on counter
            if (countQ < factor / 2) begin
                clk_ms <= 1'b0;     // Fixed: 1-bit
            end
            else begin
                clk_ms <= 1'b1;     // Fixed: 1-bit
            end
        end
    end

endmodule

// Counter logic to reset the counter, to stop (enable) the counter without resetting the current value, and to resume counting after being pause
module counter(input clk, reset_n, start_n, stop_n, output reg[WIDTH-1:0] ms_count);
    parameter WIDTH=19;
    reg enable;

    always@(posedge clk, negedge reset_n) begin
        if(!reset_n) begin
            ms_count <= {WIDTH{1'b0}};
        end else if (!start_n) begin // enable = 1, start/resume
            enable <= b'1;
        end else if (!stop_n) begin // enable = 0, pause
            enable <= b'0;
        end

        if (enable) begin // count when enabled
            ms_count <= ms_count + 1'b1;
        end
    end
endmodule

module seven_seg(input [3:0] digit, output [6:0] HEX);
    reg [6:0] reg_LEDs;
    //assign HEX[6:0]=reg_LEDs[6:0];
    assign HEX = reg_LEDs;
    always @(*) begin
        case (digit)
            4'b0000: reg_LEDs[6:0]=7'b1000000; // decimal 0
            4'b0001: reg_LEDs[6:0]=7'b1111001; // decimal 1
            4'b0010: reg_LEDs[6:0]=7'b0100100; // decimal 2
            4'b0011: reg_LEDs[6:0]=7'b0110000; // decimal 3
            4'b0100: reg_LEDs[6:0]=7'b0011001; // decimal 4
            4'b0101: reg_LEDs[6:0]=7'b0010010; // decimal 5
            4'b0110: reg_LEDs[6:0]=7'b0000010; // decimal 6
            4'b0111: reg_LEDs[6:0]=7'b1111000; // decimal 7
            4'b1000: reg_LEDs[6:0]=7'b0000000; // decimal 8
            4'b1001: reg_LEDs[6:0]=7'b0010000; // decimal 9
            4'b1111: reg_LEDs[6:0]=7'b1111111; // decimal Off
            default: reg_LEDs[6:0]=7'b1111111; // for input greater than 1111
        endcase
    end
endmodule

